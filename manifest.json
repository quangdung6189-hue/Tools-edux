{
  "manifest_version": 3,
  "name": "Auto Homework Solver",
  "version": "1.2.0",
  "description": "Tự động quét câu hỏi bài tập từ trang LMS, gọi AI (9Router, Gemini, OpenRouter, Groq, Ollama... hoặc nguồn API tùy chỉnh) trả lời và điền đáp án.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/utils.js",
        "content/scanners.js",
        "content/fillers.js",
        "content/navigation.js",
        "content/auto-solver.js",
        "content/floating-bar.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
